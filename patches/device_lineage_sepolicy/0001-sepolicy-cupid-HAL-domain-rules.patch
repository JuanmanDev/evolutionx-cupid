diff --git a/common/vendor/hal_lineage_health_default.te b/common/vendor/hal_lineage_health_default.te
index d3b7c16..6b42d62 100644
--- a/common/vendor/hal_lineage_health_default.te
+++ b/common/vendor/hal_lineage_health_default.te
@@ -1,3 +1,11 @@
+# Estos atributos ya los declara common/public/attributes con
+# hal_attribute_lineage(...), que tambien entra en la politica de vendor.
+# Declararlos aqui hace que checkpolicy aborte con "Duplicate declaration
+# of type". Se dejan comentados: la fuente unica es common/public.
+# attribute hal_lineage_health;
+# attribute hal_lineage_health_client;
+# attribute hal_lineage_health_server;
+
 type hal_lineage_health_default, domain;
 hal_server_domain(hal_lineage_health_default, hal_lineage_health)
 
