diff --git a/qcom/dynamic/hal_lineage_livedisplay_sysfs.te b/qcom/dynamic/hal_lineage_livedisplay_sysfs.te
index f3995d2..621da20 100644
--- a/qcom/dynamic/hal_lineage_livedisplay_sysfs.te
+++ b/qcom/dynamic/hal_lineage_livedisplay_sysfs.te
@@ -1,3 +1,6 @@
+# Declarado en common/dynamic/file.te (ver BoardConfigCommon.mk).
+# Declarado en common/vendor/hal_lineage_livedisplay_sysfs.te.
+
 # Allow LiveDisplay to access vendor display property
 get_prop(hal_lineage_livedisplay_sysfs, vendor_display_prop)
 
diff --git a/qcom/vendor/fm_app.te b/qcom/vendor/fm_app.te
index c37e8f5..10ebae1 100644
--- a/qcom/vendor/fm_app.te
+++ b/qcom/vendor/fm_app.te
@@ -1 +1,3 @@
+# Declarada en common/vendor/property.te (fuente unica).
+# vendor_public_prop(vendor_fm_radio_app_prop)
 get_prop(vendor_fm_app, vendor_fm_radio_app_prop)
diff --git a/qcom/vendor/hal_gnss_qti.te b/qcom/vendor/hal_gnss_qti.te
index 4e914a2..e8aedf7 100644
--- a/qcom/vendor/hal_gnss_qti.te
+++ b/qcom/vendor/hal_gnss_qti.te
@@ -1,2 +1,4 @@
+# Declarada en common/public/property.te como system_restricted_prop, que es la
+# que usa common/private/system_server.te para escribirla.
 # xtra-daemon control
 dontaudit hal_gnss_qti xtra_control_prop:file r_file_perms;
diff --git a/qcom/vendor/hal_lineage_health_default.te b/qcom/vendor/hal_lineage_health_default.te
index 26de236..21cba9e 100644
--- a/qcom/vendor/hal_lineage_health_default.te
+++ b/qcom/vendor/hal_lineage_health_default.te
@@ -1,2 +1,7 @@
-rw_dir_file(hal_lineage_health_default, sysfs_battery_supply)
-rw_dir_file(hal_lineage_health_default, sysfs_usb_supply)
+# Declarado en device/lineage/sepolicy/common/vendor/hal_lineage_health_default.te,
+# que ahora si se compila (ver device/xiaomi/sm8450-common/BoardConfigCommon.mk).
+# Duplicarlo aqui rompe checkpolicy: Duplicate declaration of type.
+allow hal_lineage_health_default sysfs_battery_supply:dir r_dir_perms;
+allow hal_lineage_health_default sysfs_battery_supply:file rw_file_perms;
+allow hal_lineage_health_default sysfs_usb_supply:dir r_dir_perms;
+allow hal_lineage_health_default sysfs_usb_supply:file rw_file_perms;
diff --git a/qcom/vendor/hal_lineage_livedisplay_qti.te b/qcom/vendor/hal_lineage_livedisplay_qti.te
index 4950726..0fd6035 100644
--- a/qcom/vendor/hal_lineage_livedisplay_qti.te
+++ b/qcom/vendor/hal_lineage_livedisplay_qti.te
@@ -1,3 +1,11 @@
+# Estos atributos ya los declara common/public/attributes con
+# hal_attribute_lineage(...), que tambien entra en la politica de vendor.
+# Declararlos aqui hace que checkpolicy aborte con "Duplicate declaration
+# of type". Se dejan comentados: la fuente unica es common/public.
+# attribute hal_lineage_livedisplay;
+# attribute hal_lineage_livedisplay_client;
+# attribute hal_lineage_livedisplay_server;
+
 type hal_lineage_livedisplay_qti, domain;
 hal_server_domain(hal_lineage_livedisplay_qti, hal_lineage_livedisplay)
 
diff --git a/qcom/vendor/hal_perf_default.te b/qcom/vendor/hal_perf_default.te
index 9125357..e1e63e2 100644
--- a/qcom/vendor/hal_perf_default.te
+++ b/qcom/vendor/hal_perf_default.te
@@ -1,3 +1,4 @@
 r_dir_file(hal_perf_default, hal_power_default)
 
-rw_dir_file(hal_perf_default, proc_sched)
+allow hal_perf_default proc_sched:dir r_dir_perms;
+allow hal_perf_default proc_sched:file rw_file_perms;
diff --git a/qcom/vendor/hal_power_default.te b/qcom/vendor/hal_power_default.te
index 969819c..a3e22f9 100644
--- a/qcom/vendor/hal_power_default.te
+++ b/qcom/vendor/hal_power_default.te
@@ -1,6 +1,11 @@
 # To do powerhint on nodes defined in powerhint.json
-rw_dir_file(hal_power_default, proc_sched)
-rw_dir_file(hal_power_default, sysfs_devfreq)
-rw_dir_file(hal_power_default, sysfs_graphics)
-rw_dir_file(hal_power_default, sysfs_kgsl)
-rw_dir_file(hal_power_default, sysfs_scsi_host)
+allow hal_power_default proc_sched:dir r_dir_perms;
+allow hal_power_default proc_sched:file rw_file_perms;
+allow hal_power_default sysfs_devfreq:dir r_dir_perms;
+allow hal_power_default sysfs_devfreq:file rw_file_perms;
+allow hal_power_default sysfs_graphics:dir r_dir_perms;
+allow hal_power_default sysfs_graphics:file rw_file_perms;
+allow hal_power_default sysfs_kgsl:dir r_dir_perms;
+allow hal_power_default sysfs_kgsl:file rw_file_perms;
+allow hal_power_default sysfs_scsi_host:dir r_dir_perms;
+allow hal_power_default sysfs_scsi_host:file rw_file_perms;
