index 98ef45e..3ff4529 100644
--- a/common/vendor/hal_lineage_livedisplay_sysfs.te
+++ b/common/vendor/hal_lineage_livedisplay_sysfs.te
@@ -1,3 +1,11 @@
+# Estos atributos ya los declara common/public/attributes con
