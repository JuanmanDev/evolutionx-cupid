 common/vendor/hal_lineage_health_default.te     |  8 ++++++++
 common/vendor/hal_lineage_livedisplay_sysfs.te  |  8 ++++++++
 common/vendor/hal_lineage_powershare_default.te |  8 ++++++++
 common/vendor/hal_lineage_touch_default.te      |  8 ++++++++
