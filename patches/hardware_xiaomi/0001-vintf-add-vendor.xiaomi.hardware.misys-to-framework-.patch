 vintf/xiaomi_framework_compatibility_matrix.xml | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/vintf/xiaomi_framework_compatibility_matrix.xml b/vintf/xiaomi_framework_compatibility_matrix.xml
