From a973e98f0444e4fe6cc2b7c480ec3c4649b729ae Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Juan=20Manuel=20B=C3=A9c?= <Juanmabs22@hotmail.com>
Date: Mon, 14 Sep 2026 18:04:28 +0200
Subject: [PATCH] rmnetctl: use stock HyperOS librmnetctl.so prebuilt (exports
 rmnetctl_init/rmnet_get_vnd_name)

Local production changes for Xiaomi 12 (cupid), snapshot 2026-09-14.

     rmnetctl/Android.bp              |  20 +++++++++++++-------
     rmnetctl/prebuilt/librmnetctl.so | Bin 0 -> 38880 bytes
     2 files changed, 13 insertions(+), 7 deletions(-)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 rmnetctl/Android.bp              |  20 +++++++++++++-------
 rmnetctl/prebuilt/librmnetctl.so | Bin 0 -> 38880 bytes
 2 files changed, 13 insertions(+), 7 deletions(-)
 create mode 100644 rmnetctl/prebuilt/librmnetctl.so

diff --git a/rmnetctl/Android.bp b/rmnetctl/Android.bp
index cc0fef5..757e100 100644
--- a/rmnetctl/Android.bp
+++ b/rmnetctl/Android.bp
@@ -17,14 +17,20 @@ cc_defaults {
     vendor: true,
 }
 
-cc_library_shared {
+// La version compilada desde src/librmnetctl.c no exporta rmnetctl_init ni
+// rmnet_get_vnd_name, que netmgrd y adpl necesitan para crear las interfaces
+// rmnet (sin ellas no hay datos moviles). Esos simbolos solo existen con
+// -DUSE_OLD_RMNET_DATA, que requiere linux/rmnet_data.h: la cabecera esta en
+// kernel/xiaomi/sm8450/include/uapi pero no se exporta a la compilacion.
+// Mientras eso no se resuelva se usa la libreria de HyperOS stock.
+cc_prebuilt_library_shared {
     name: "librmnetctl",
-    header_libs: [
-        "qti_kernel_headers",
-        "device_kernel_headers",
-    ],
-    defaults: ["librmnetctl_defaults"],
-    srcs: ["src/librmnetctl.c"],
+    owner: "xiaomi",
+    srcs: ["prebuilt/librmnetctl.so"],
+    compile_multilib: "64",
+    check_elf_files: false,
+    strip: { none: true },
+    vendor: true,
 }
 
 cc_binary {
diff --git a/rmnetctl/prebuilt/librmnetctl.so b/rmnetctl/prebuilt/librmnetctl.so
new file mode 100644
index 0000000000000000000000000000000000000000..1f8068710dfbffeabfba6ce21d566016a64f657c
GIT binary patch
