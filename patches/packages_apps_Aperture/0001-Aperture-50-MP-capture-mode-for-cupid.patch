diff --git a/app/src/main/java/org/lineageos/aperture/Actividad50Mp.kt b/app/src/main/java/org/lineageos/aperture/Actividad50Mp.kt
new file mode 100644
index 0000000..e4bac89
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/Actividad50Mp.kt
@@ -0,0 +1,96 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture
+
+import android.app.Activity
+import android.graphics.Color
+import android.net.Uri
+import android.os.Bundle
+import android.view.Gravity
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import android.widget.Toast
+import org.lineageos.aperture.utils.Foto50Mp
+
+/**
+ * Pantalla dedicada a la foto de resolucion completa.
+ *
+ * Esto no se puede hacer dentro de la pantalla normal de la camara. Alli hay
+ * que soltar CameraX para dejar la camara libre, y al soltarla esa pantalla se
+ * cierra sola: el sistema congela la aplicacion y la foto, que tarda dos o tres
+ * segundos, se queda esperando una imagen que ya no va a recoger nadie. Ademas,
+ * en cuanto la aplicacion deja de estar a la vista, Android le quita la camara a
+ * media captura:
+ *
+ *     Camera 0: Access for "org.lineageos.aperture" has been restricted,
+ *     isUidVisible 0, procState 18
+ *
+ * Aqui no hay nada que soltar. Esta pantalla no usa CameraX, se queda delante
+ * mientras dura la captura y se cierra cuando termina.
+ */
+class Actividad50Mp : Activity() {
+    private var enMarcha = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        // Mientras se hace la foto la pantalla no se apaga: si se apagase, el
+        // sistema dejaria de considerar visible la aplicacion y le retiraria la
+        // camara antes de que llegue la imagen.
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        setContentView(pantallaDeEspera())
+
+        if (savedInstanceState == null) {
+            hacerLaFoto()
+        }
+    }
+
+    private fun pantallaDeEspera(): ViewGroup {
+        val texto = TextView(this).apply {
+            text = getString(R.string.photo_fifty_mp_working)
+            setTextColor(Color.WHITE)
+            textSize = 16f
+            gravity = Gravity.CENTER
+        }
+        return LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER
+            setBackgroundColor(Color.BLACK)
+            addView(ProgressBar(this@Actividad50Mp))
+            addView(
+                texto,
+                LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT
+                ).apply { topMargin = 48 }
+            )
+        }
+    }
+
+    private fun hacerLaFoto() {
+        if (enMarcha) {
+            return
+        }
+        enMarcha = true
+        Foto50Mp(this).capturar { uri -> runOnUiThread { terminar(uri) } }
+    }
+
+    private fun terminar(uri: Uri?) {
+        if (isFinishing || isDestroyed) {
+            return
+        }
+        if (uri == null) {
+            Toast.makeText(
+                this, R.string.photo_fifty_mp_failed, Toast.LENGTH_SHORT
+            ).show()
+        }
+        setResult(if (uri != null) RESULT_OK else RESULT_CANCELED)
+        finish()
+    }
+}
