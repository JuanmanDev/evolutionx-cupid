diff --git a/app/src/main/java/org/lineageos/aperture/utils/Foto50Mp.kt b/app/src/main/java/org/lineageos/aperture/utils/Foto50Mp.kt
new file mode 100644
index 0000000..f2d456c
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/utils/Foto50Mp.kt
@@ -0,0 +1,527 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.utils
+
+import android.content.ContentValues
+import android.content.Context
+import android.graphics.ImageFormat
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraDevice
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.CaptureRequest
+import android.hardware.camera2.params.OutputConfiguration
+import android.hardware.camera2.params.SessionConfiguration
+import android.media.ImageReader
+import android.net.Uri
+import android.os.Handler
+import android.os.HandlerThread
+import android.provider.MediaStore
+import android.util.Log
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * Foto a la resolucion completa del sensor (50 MP), por Camera2.
+ *
+ * CameraX no sirve para esto. Reserva cuatro imagenes a la vez y a este tamano
+ * cada una ocupa unos 100 MB de memoria contigua; cuando el HAL intenta mapear
+ * la cuarta se cae y se lleva la camara por delante:
+ *
+ *     [MEMMGR] Import() Failed in importing Gralloc Buffer Handle, WxH 8192x6144
+ *     Camera provider has died
+ *
+ * Ese numero lo decide CameraX por dentro y no se puede cambiar desde la app,
+ * asi que para la foto grande se sale de CameraX y se habla con Camera2 a
+ * pelo, pidiendo una sola imagen. Medido en el movil: con una, dos o tres
+ * funciona; con cuatro, no.
+ *
+ * Del modo de sesion propietario y de la etiqueta de remosaico se encarga el
+ * servicio de camara en cuanto ve una salida JPEG de este tamano, asi que aqui
+ * basta con pedirla.
+ *
+ * Mientras dura la captura no hay vista previa: son un par de segundos, y la
+ * camara tiene que soltarla antes quien la tuviera.
+ */
+class Foto50Mp(private val context: Context) {
+    private var hilo: HandlerThread? = null
+    private var handler: Handler? = null
+    private var camara: CameraDevice? = null
+    private var sesion: CameraCaptureSession? = null
+    private var lector: ImageReader? = null
+    private var lectorAux: ImageReader? = null
+
+    /** Para no llamar dos veces a quien espera el resultado. */
+    private val terminado = java.util.concurrent.atomic.AtomicBoolean(false)
+    private var vigilante: CameraManager.AvailabilityCallback? = null
+
+    /**
+     * Los plazos van por el hilo principal a proposito. Si fueran por el mismo
+     * hilo que habla con la camara, un bloqueo ahi dentro se los llevaria por
+     * delante justo cuando hacen falta.
+     */
+    private val plazos = Handler(android.os.Looper.getMainLooper())
+
+    /**
+     * Hace la foto y devuelve donde ha quedado guardada, o null si no ha
+     * podido. La llamada vuelve enseguida; el resultado llega por [alTerminar].
+     */
+    fun capturar(alTerminar: (Uri?) -> Unit) {
+        val manager = context.getSystemService(CameraManager::class.java)
+        if (manager == null) {
+            alTerminar(null)
+            return
+        }
+        val idCamara = idDeLaPrincipal(manager)
+        if (idCamara == null) {
+            Log.e(TAG, "no hay ninguna camara trasera con tamano completo")
+            alTerminar(null)
+            return
+        }
+        val medidas = tamanoCompleto(manager, idCamara)
+        if (medidas == null) {
+            Log.e(TAG, "la camara " + idCamara + " no ofrece el tamano completo")
+            alTerminar(null)
+            return
+        }
+        val ancho = medidas.first
+        val alto = medidas.second
+
+        val nuevoHilo = HandlerThread("foto50mp")
+        nuevoHilo.start()
+        hilo = nuevoHilo
+        handler = Handler(nuevoHilo.looper)
+        Log.i(TAG, "hilo listo, se prepara la captura de " + ancho + "x" + alto)
+
+        val orientacion = runCatching {
+            manager.getCameraCharacteristics(idCamara)
+                .get(CameraCharacteristics.SENSOR_ORIENTATION) ?: 0
+        }.getOrElse {
+            Log.e(TAG, "no se pudo leer la orientacion", it)
+            0
+        }
+
+        // Una sola imagen: es justo lo que el HAL aguanta a este tamano.
+        lector = runCatching {
+            ImageReader.newInstance(ancho, alto, ImageFormat.JPEG, 1)
+        }.getOrElse {
+            Log.e(TAG, "no se pudo reservar la imagen de " + ancho + "x" + alto, it)
+            acabar(alTerminar, null)
+            return
+        }
+        lector!!.setOnImageAvailableListener({ lectorListo ->
+            var uri: Uri? = null
+            try {
+                val imagen = lectorListo.acquireLatestImage()
+                if (imagen != null) {
+                    imagen.use {
+                        val bufer = it.planes[0].buffer
+                        val datos = ByteArray(bufer.remaining())
+                        bufer.get(datos)
+                        uri = guardar(datos, ancho, alto)
+                    }
+                }
+            } catch (e: Throwable) {
+                Log.e(TAG, "no se pudo guardar la foto de 50 MP", e)
+            }
+            acabar(alTerminar, uri)
+        }, handler)
+
+        // El HAL quiere una segunda salida ademas de la foto. Esta no se ve en
+        // ningun sitio, solo esta para que la sesion sea valida.
+        lectorAux = runCatching {
+            ImageReader.newInstance(ANCHO_AUX, ALTO_AUX, ImageFormat.PRIVATE, 2)
+        }.getOrElse {
+            Log.e(TAG, "no se pudo reservar la salida auxiliar", it)
+            acabar(alTerminar, null)
+            return
+        }
+        Log.i(TAG, "salidas preparadas; se espera a que la camara quede libre")
+
+        // La camara puede seguir ocupada por quien la tuviera: soltarla no es
+        // inmediato. Se espera al aviso del sistema y, si no llega a tiempo, se
+        // abandona en vez de quedarse colgado.
+        esperarYAbrir(manager, idCamara, orientacion, alTerminar)
+    }
+
+    /**
+     * Abre la camara en cuanto este libre. Si en [ESPERA_MAXIMA_MS] no lo esta,
+     * se rinde y avisa: mejor perder la foto que dejar la camara bloqueada.
+     */
+    private fun esperarYAbrir(
+        manager: CameraManager, idCamara: String, orientacion: Int,
+        alTerminar: (Uri?) -> Unit
+    ) {
+        val abrir = {
+            Log.i(TAG, "toca abrir la camara (terminado=" + terminado.get() + ")")
+            if (!terminado.get()) {
+                quitarVigilante(manager)
+                abrirDeVerdad(manager, idCamara, orientacion, alTerminar)
+            }
+        }
+
+        // Plazo maximo, pase lo que pase.
+        plazos.postDelayed({
+            if (camara == null && !terminado.get()) {
+                Log.e(TAG, "la camara sigue ocupada; se abandona la foto de 50 MP")
+                quitarVigilante(manager)
+                acabar(alTerminar, null)
+            }
+        }, ESPERA_MAXIMA_MS)
+
+        val nuevoVigilante = object : CameraManager.AvailabilityCallback() {
+            override fun onCameraAvailable(id: String) {
+                if (id == idCamara) {
+                    Log.i(TAG, "la camara ha quedado libre")
+                    abrir()
+                }
+            }
+        }
+        vigilante = nuevoVigilante
+        runCatching { manager.registerAvailabilityCallback(nuevoVigilante, handler) }
+
+        // Puede que ya estuviera libre y el aviso no vuelva a llegar: se prueba
+        // igualmente pasado un instante.
+        plazos.postDelayed({ handler?.post { abrir() } }, ESPERA_CORTESIA_MS)
+    }
+
+    private fun quitarVigilante(manager: CameraManager) {
+        vigilante?.let { runCatching { manager.unregisterAvailabilityCallback(it) } }
+        vigilante = null
+    }
+
+    /** Contesta una sola vez y deja todo cerrado. */
+    private fun acabar(alTerminar: (Uri?) -> Unit, uri: Uri?) {
+        if (terminado.compareAndSet(false, true)) {
+            plazos.removeCallbacksAndMessages(null)
+            cerrar()
+            alTerminar(uri)
+        }
+    }
+
+    private fun abrirDeVerdad(
+        manager: CameraManager, idCamara: String, orientacion: Int,
+        alTerminar: (Uri?) -> Unit
+    ) {
+        if (camara != null) {
+            return
+        }
+        Log.i(TAG, "abriendo la camara " + idCamara)
+        try {
+            manager.openCamera(idCamara, object : CameraDevice.StateCallback() {
+                override fun onOpened(dispositivo: CameraDevice) {
+                    Log.i(TAG, "camara abierta; se configura la sesion")
+                    camara = dispositivo
+                    configurar(dispositivo, orientacion, alTerminar)
+                }
+
+                override fun onDisconnected(dispositivo: CameraDevice) {
+                    dispositivo.close()
+                    camara = null
+                    acabar(alTerminar, null)
+                }
+
+                override fun onError(dispositivo: CameraDevice, error: Int) {
+                    Log.e(TAG, "no se pudo abrir la camara: " + error)
+                    dispositivo.close()
+                    camara = null
+                    acabar(alTerminar, null)
+                }
+            }, handler)
+        } catch (e: Throwable) {
+            Log.e(TAG, "fallo al abrir la camara", e)
+            acabar(alTerminar, null)
+        }
+    }
+
+    /**
+     * Primero una sesion normal solo con la salida auxiliar, para que la
+     * exposicion y el enfoque converjan. Sin esto el HAL entrega una imagen
+     * pequena y en un suspiro en lugar de la de resolucion completa.
+     */
+    private fun configurar(
+        dispositivo: CameraDevice, orientacion: Int, alTerminar: (Uri?) -> Unit
+    ) {
+        val respuesta = object : CameraCaptureSession.StateCallback() {
+            override fun onConfigured(nueva: CameraCaptureSession) {
+                Log.i(TAG, "previa en marcha; midiendo la escena")
+                sesion = nueva
+                val arrancada = runCatching {
+                    val previa = dispositivo.createCaptureRequest(
+                        CameraDevice.TEMPLATE_PREVIEW
+                    )
+                    previa.addTarget(lectorAux!!.surface)
+                    previa.set(
+                        CaptureRequest.CONTROL_AF_MODE,
+                        CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE
+                    )
+                    nueva.setRepeatingRequest(previa.build(), null, handler)
+                }.isSuccess
+                plazos.postDelayed({
+                    handler?.post {
+                        // La previa se cierra del todo antes de pedir la foto:
+                        // si se queda viva dentro de la sesion de resolucion
+                        // completa, el HAL aborta atendiendola.
+                        runCatching { nueva.stopRepeating() }
+                        runCatching { nueva.close() }
+                        sesion = null
+                        sesionDeFoto(dispositivo, orientacion, alTerminar)
+                    }
+                }, if (arrancada) ESPERA_PREVIA_MS else 0L)
+            }
+
+            override fun onConfigureFailed(nueva: CameraCaptureSession) {
+                Log.w(TAG, "no se pudo abrir la previa; se va directo a la foto")
+                sesionDeFoto(dispositivo, orientacion, alTerminar)
+            }
+        }
+        try {
+            dispositivo.createCaptureSession(
+                SessionConfiguration(
+                    SessionConfiguration.SESSION_REGULAR,
+                    listOf(OutputConfiguration(lectorAux!!.surface)),
+                    { orden -> handler?.post(orden) }, respuesta
+                )
+            )
+        } catch (e: Throwable) {
+            Log.e(TAG, "fallo al preparar la previa", e)
+            sesionDeFoto(dispositivo, orientacion, alTerminar)
+        }
+    }
+
+    /**
+     * La sesion de la foto: modo propietario, una sola captura y ninguna
+     * peticion repetida corriendo.
+     */
+    private fun sesionDeFoto(
+        dispositivo: CameraDevice, orientacion: Int, alTerminar: (Uri?) -> Unit
+    ) {
+        if (terminado.get()) {
+            return
+        }
+        val salidas = listOf(
+            OutputConfiguration(lectorAux!!.surface),
+            OutputConfiguration(lector!!.surface)
+        )
+        val respuesta = object : CameraCaptureSession.StateCallback() {
+            override fun onConfigured(nueva: CameraCaptureSession) {
+                Log.i(TAG, "sesion de foto configurada")
+                sesion = nueva
+                disparar(dispositivo, nueva, orientacion, alTerminar)
+            }
+
+            override fun onConfigureFailed(nueva: CameraCaptureSession) {
+                Log.e(TAG, "el HAL rechazo la sesion de 50 MP (modo "
+                        + MODO_RESOLUCION_COMPLETA + ")")
+                acabar(alTerminar, null)
+            }
+        }
+        try {
+            // createCustomCaptureSession no comprueba el tamano contra la lista
+            // publicada, que es justo lo que hace falta: el HAL sabe entregar
+            // los 50 MP aunque no los anuncie. El modo es el propietario de
+            // Xiaomi para el mosaico completo.
+            Log.i(TAG, "pidiendo sesion en modo " + MODO_RESOLUCION_COMPLETA)
+            dispositivo.createCustomCaptureSession(
+                null, salidas, MODO_RESOLUCION_COMPLETA, respuesta, handler
+            )
+            plazos.postDelayed({
+                if (sesion == null && !terminado.get()) {
+                    Log.e(TAG, "el HAL no ha contestado a la sesion de 50 MP")
+                    acabar(alTerminar, null)
+                }
+            }, ESPERA_SESION_MS)
+        } catch (e: Throwable) {
+            Log.e(TAG, "fallo al preparar la sesion", e)
+            acabar(alTerminar, null)
+        }
+    }
+
+    private fun disparar(
+        dispositivo: CameraDevice, sesionActiva: CameraCaptureSession,
+        orientacion: Int, alTerminar: (Uri?) -> Unit
+    ) {
+        try {
+            val constructor = dispositivo.createCaptureRequest(
+                CameraDevice.TEMPLATE_STILL_CAPTURE
+            )
+            constructor.addTarget(lector!!.surface)
+            constructor.set(CaptureRequest.JPEG_ORIENTATION, orientacion)
+            constructor.set(CaptureRequest.JPEG_QUALITY, CALIDAD)
+            constructor.set(
+                CaptureRequest.CONTROL_AF_MODE,
+                CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE
+            )
+            // A esta resolucion la reduccion de ruido alta emborrona justo el
+            // detalle fino que se venia a buscar.
+            constructor.set(
+                CaptureRequest.NOISE_REDUCTION_MODE,
+                CaptureRequest.NOISE_REDUCTION_MODE_MINIMAL
+            )
+            constructor.set(
+                CaptureRequest.EDGE_MODE,
+                CaptureRequest.EDGE_MODE_HIGH_QUALITY
+            )
+            // Sin esta etiqueta el HAL devuelve la imagen recortada aunque el
+            // tamano pedido sea el grande.
+            for (etiqueta in ETIQUETAS) {
+                runCatching {
+                    constructor.set(
+                        CaptureRequest.Key(etiqueta, Byte::class.java), 1.toByte()
+                    )
+                }.onFailure { Log.w(TAG, "no se pudo poner " + etiqueta + ": " + it) }
+            }
+            Log.i(TAG, "enviando el disparo")
+            sesionActiva.capture(constructor.build(), null, handler)
+            Log.i(TAG, "disparo enviado; esperando la imagen")
+            plazos.postDelayed({
+                if (!terminado.get()) {
+                    Log.e(TAG, "el HAL no ha entregado la foto a tiempo")
+                    acabar(alTerminar, null)
+                }
+            }, ESPERA_FOTO_MS)
+        } catch (e: Throwable) {
+            Log.e(TAG, "fallo al disparar", e)
+            acabar(alTerminar, null)
+        }
+    }
+
+    private fun guardar(datos: ByteArray, ancho: Int, alto: Int): Uri? {
+        val marca = SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(Date())
+        val valores = ContentValues()
+        valores.put(MediaStore.Images.Media.DISPLAY_NAME, "IMG_" + marca + "_50MP.jpg")
+        valores.put(MediaStore.Images.Media.MIME_TYPE, "image/jpeg")
+        valores.put(MediaStore.Images.Media.RELATIVE_PATH, "DCIM/Camera")
+        valores.put(MediaStore.Images.Media.WIDTH, ancho)
+        valores.put(MediaStore.Images.Media.HEIGHT, alto)
+        val uri = context.contentResolver.insert(
+            MediaStore.Images.Media.EXTERNAL_CONTENT_URI, valores
+        ) ?: return null
+        context.contentResolver.openOutputStream(uri)?.use { it.write(datos) }
+        Log.i(TAG, "foto de 50 MP guardada: " + datos.size + " bytes, " + ancho + "x" + alto)
+        return uri
+    }
+
+    private fun cerrar() {
+        runCatching { sesion?.close() }
+        runCatching { camara?.close() }
+        runCatching { lector?.close() }
+        runCatching { lectorAux?.close() }
+        sesion = null
+        camara = null
+        lector = null
+        lectorAux = null
+        hilo?.quitSafely()
+        hilo = null
+        handler = null
+    }
+
+    /**
+     * La primera camara trasera que ofrezca una foto del tamano del sensor.
+     *
+     * Cada camara se mira por separado a proposito: alguna de las que declara
+     * el movil da error al consultarla, y si se envuelve el recorrido entero
+     * en un try ese fallo se lleva por delante tambien a las que si valen.
+     */
+    private fun idDeLaPrincipal(manager: CameraManager): String? {
+        val ids = runCatching { manager.cameraIdList }.getOrNull() ?: return null
+        for (id in ids) {
+            val caracteristicas = runCatching {
+                manager.getCameraCharacteristics(id)
+            }.getOrNull() ?: continue
+            if (caracteristicas.get(CameraCharacteristics.LENS_FACING) !=
+                CameraCharacteristics.LENS_FACING_BACK
+            ) {
+                continue
+            }
+            val medidas = tamanoCompleto(manager, id)
+            Log.i(TAG, "camara " + id + ": tamano completo " + medidas)
+            if (medidas != null) {
+                return id
+            }
+        }
+        return null
+    }
+
+    /**
+     * El tamano de foto mas grande que anuncia la camara, si es mayor que lo
+     * que da el sensor agrupando pixeles. Si no lo hay, no hay nada que hacer
+     * aqui y la foto se hace por el camino de siempre.
+     */
+    private fun tamanoCompleto(manager: CameraManager, id: String): Pair<Int, Int>? {
+        val caracteristicas = runCatching {
+            manager.getCameraCharacteristics(id)
+        }.getOrNull() ?: return null
+
+        // No se mira la lista de tamanos publicados: el grande no esta ahi, por
+        // eso hace falta todo esto. Se mira lo que el sensor dice medir cuando
+        // no agrupa pixeles, que es lo que el HAL sabe entregar.
+        val completo = caracteristicas.get(
+            CameraCharacteristics.SENSOR_INFO_PIXEL_ARRAY_SIZE_MAXIMUM_RESOLUTION
+        )
+        if (completo != null &&
+            completo.width.toLong() * completo.height > AREA_MINIMA
+        ) {
+            return Pair(completo.width, completo.height)
+        }
+
+        // Y si alguna camara si lo publica, se aprovecha.
+        val mapa = caracteristicas.get(
+            CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP
+        ) ?: return null
+        val mayor = mapa.getOutputSizes(ImageFormat.JPEG)
+            ?.maxByOrNull { it.width.toLong() * it.height } ?: return null
+        return if (mayor.width.toLong() * mayor.height > AREA_MINIMA) {
+            Pair(mayor.width, mayor.height)
+        } else {
+            null
+        }
+    }
+
+    companion object {
+        private const val TAG = "Foto50Mp"
+
+        /** Solo se considera resolucion completa por encima de esto. */
+        private const val AREA_MINIMA = 4208L * 3120L
+
+        /**
+         * Modo de sesion propietario de Xiaomi para el mosaico completo.
+         * Medido en el movil: con este sale la foto de 8192x6144; con el 36868
+         * que usa la comunidad para otros modelos, el HAL rechaza la sesion.
+         */
+        private const val MODO_RESOLUCION_COMPLETA = 0x80F3
+
+        /**
+         * La primera es la que de verdad trae los 50 MP; la segunda le dice al
+         * HAL que conserve el detalle fino en vez de pasar por los filtros
+         * temporales. Son las mismas que usa la camara propia.
+         */
+        private val ETIQUETAS = arrayOf(
+            "xiaomi.remosaic.enabled",
+            "xiaomi.pureView.enabled"
+        )
+
+        /** Lo que se deja correr la previa antes de disparar. */
+        private const val ESPERA_PREVIA_MS = 1500L
+
+        /** Margen para que quien tuviera la camara acabe de soltarla. */
+        private const val ESPERA_CORTESIA_MS = 400L
+
+        /** Si en este tiempo no queda libre, se abandona la foto. */
+        private const val ESPERA_MAXIMA_MS = 4000L
+
+        /** Lo que se le da al HAL para aceptar o rechazar la sesion. */
+        private const val ESPERA_SESION_MS = 8000L
+
+        /** Y esto es lo que se le da al HAL para entregar la imagen. */
+        private const val ESPERA_FOTO_MS = 20000L
+
+        private const val ANCHO_AUX = 1920
+        private const val ALTO_AUX = 1440
+        private const val CALIDAD: Byte = 95
+    }
+}
