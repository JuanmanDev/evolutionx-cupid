+// Le dice a la aplicacion que el remosaico esta disponible.
+//
+// La camara de Xiaomi mira xiaomi.remosaic.detected en el resultado antes de
+// pedir el remosaico. El HAL la manda a 0, asi que no lo pide nunca, el flujo de
+// 8192x6144 se queda sin datos y la foto de 50 MP sale entera verde. El HAL sabe
+// hacer el remosaico —Aperture saca sus 50 MP reales— pero no lo anuncia en la
+// sesion de esa aplicacion.
+//
+// Hay que escribirlo aqui, segun entra el resultado del HAL: mas adelante los
+// metadatos ya estan bloqueados y update() devuelve INVALID_OPERATION.
+//
+// Apagado por defecto, porque mientras este puesto toca los resultados de todas
+// las camaras:
+//
+//     setprop persist.sys.camera.qcfa_remosaic_detected 1
+// Contador para saber por que rama llega el resultado del HAL.
+//
+// Se enciende con: setprop persist.sys.camera.qcfa_mapa 1
+static void mapaRama(const char *donde, int a, int b, int c) {
+    if (property_get_int32("persist.sys.camera.qcfa_mapa", 0) == 0) {
+        return;
+    }
+    static int lineas = 0;
+    if (lineas >= 40) return;
+    lineas++;
+    ALOGI("qcfamapa: %s | %d %d %d", donde, a, b, c);
+}
+
+static void decirQueElRemosaicoEstaListo(CameraMetadata &resultado) {
+    if (property_get_int32("persist.sys.camera.qcfa_remosaic_detected", 0) == 0) {
+        return;
+    }
+    const uint32_t etiqueta = (uint32_t) property_get_int32(
+            "persist.sys.camera.qcfa_detected_tag", 0x810e0001);
+
+    // Nada de update(): con etiquetas de fabricante no consigue resolver el
+    // tipo y devuelve -38 ("Unknown tag"). La entrada ya viene en el resultado
+    // —el HAL la manda a 0— asi que se cambia la que hay, que ya trae su tipo.
+    camera_metadata_t *bruto = resultado.release();
+    if (bruto == nullptr) {
+        return;
+    }
+    camera_metadata_entry_t entrada;
+    status_t res = find_camera_metadata_entry(bruto, etiqueta, &entrada);
+    if (res == OK && entrada.count >= 1) {
+        const uint8_t si = 1;
+        res = update_camera_metadata_entry(bruto, entrada.index, &si, 1, nullptr);
+    }
+    resultado.acquire(bruto);
+
+    static int contados = 0;
+    if (contados < 40) {
+        contados++;
+        ALOGI("qcfa: xiaomi.remosaic.detected (0x%x) en su sitio -> %d",
+                etiqueta, res);
+    }
+}
