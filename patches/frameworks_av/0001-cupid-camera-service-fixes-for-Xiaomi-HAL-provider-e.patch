+    mFullSizeQuadCfaWidth = 0;
+    mFullSizeQuadCfaHeight = 0;
+    {
+        const int32_t modoQuadCfa =
+                property_get_int32("persist.sys.camera.qcfa_mode", 0x80F3);
+
+        // Si la aplicacion ha configurado algo que no sea JPEG al tamano
+        // completo, conoce los modos del fabricante y no hay que tocarle nada.
+        // La camara de Xiaomi, en su modo de 50 MP, pide ademas un YUV de
+        // 8192x6144; el modo 0x80F3 a ese tamano solo acepta JPEG, asi que
+        // forzarlo dejaba ese flujo sin datos y la foto salia entera verde.
+        // Se puede desactivar esta cautela para probar si el modo propietario
+        // arregla el remosaico de la camara de Xiaomi:
+        //     setprop persist.sys.camera.qcfa_forzar_modo 1
+        bool laAppSabeLoQuePide =
+                property_get_int32("persist.sys.camera.qcfa_forzar_modo", 0) == 0
+                ? false : false;
+        const bool forzarModo =
+                property_get_int32("persist.sys.camera.qcfa_forzar_modo", 0) != 0;
+        for (size_t i = 0; i < mOutputStreams.size(); i++) {
+            sp<Camera3OutputStreamInterface> stream = mOutputStreams[i];
+            if (stream == nullptr) continue;
+            // Solo cuenta el YUV. El RAW a tamano completo no vale como senal:
+            // Aperture lo pide para guardar el DNG y si, necesita el cambio de
+            // modo. Mirando cualquier formato se quedaba en 2592x1944.
+            const int formato = stream->getFormat();
+            if (formato != HAL_PIXEL_FORMAT_YCbCr_420_888
+                    && formato != HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED) {
+                continue;
+            }
+            if ((int64_t) stream->getWidth() * stream->getHeight()
+                    > (int64_t) 4208 * 3120) {
+                ALOGI("%s: hay un flujo YUV de %dx%d: la aplicacion "
+                        "conoce el modo de resolucion completa, no se le toca",
+                        __FUNCTION__, stream->getWidth(), stream->getHeight());
+                laAppSabeLoQuePide = !forzarModo;
+                break;
+            }
+        }
+
+        // Nota: el tamano completo se apunta siempre que exista un flujo asi,
+        // aunque no se cambie el modo. La etiqueta del remosaico hace falta
+        // igual, y a la camara de Xiaomi es lo unico que se le toca.
+        for (size_t i = 0; modoQuadCfa != 0 && i < mOutputStreams.size(); i++) {
+            sp<Camera3OutputStreamInterface> stream = mOutputStreams[i];
+            if (stream == nullptr) continue;
+            if (stream->getFormat() != HAL_PIXEL_FORMAT_BLOB) continue;
+            // Cualquier JPEG mas grande que la mayor foto que el HAL anuncia
+            // por si mismo tiene que ir por el camino de resolucion completa.
+            if ((int64_t) stream->getWidth() * stream->getHeight()
+                    <= (int64_t) 4208 * 3120) {
+                continue;
+            }
+            mFullSizeQuadCfaWidth = stream->getWidth();
+            mFullSizeQuadCfaHeight = stream->getHeight();
+            if (!laAppSabeLoQuePide && operatingMode != modoQuadCfa) {
+                ALOGI("%s: foto de %dx%d: se pasa del modo de sesion %d al %d",
+                        __FUNCTION__, mFullSizeQuadCfaWidth, mFullSizeQuadCfaHeight,
+                        operatingMode, modoQuadCfa);
+                operatingMode = modoQuadCfa;
+            }
+            break;
+        }
+
+        // PRUEBA (qcfa_gcam_full=1): GCam pide RAW10/YUV a tamano completo, no
+        // BLOB, asi que el bucle de arriba no le cambia el modo y sus frames
+        // salen negros. Aqui, si esta el flag, se dispara el modo QCFA y se
+        // apunta la salida full-res tambien para RAW/YUV, para probar si el HAL
+        // entrega datos validos a un stream que no es JPEG.
+        if (property_get_int32("persist.sys.camera.qcfa_gcam_full", 0) != 0
+                && modoQuadCfa != 0 && mFullSizeQuadCfaWidth <= 0) {
+            for (size_t i = 0; i < mOutputStreams.size(); i++) {
+                sp<Camera3OutputStreamInterface> stream = mOutputStreams[i];
+                if (stream == nullptr) continue;
+                const int f = stream->getFormat();
+                const bool esRawOYuv =
+                        f == HAL_PIXEL_FORMAT_RAW10
+                        || f == HAL_PIXEL_FORMAT_RAW16
+                        || f == HAL_PIXEL_FORMAT_RAW_OPAQUE
+                        || f == HAL_PIXEL_FORMAT_YCbCr_420_888
+                        || f == HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED;
+                if (!esRawOYuv) continue;
+                if ((int64_t) stream->getWidth() * stream->getHeight()
+                        <= (int64_t) 4208 * 3120) {
+                    continue;
+                }
+                mFullSizeQuadCfaWidth = stream->getWidth();
+                mFullSizeQuadCfaHeight = stream->getHeight();
+                ALOGI("%s: [gcam_full] flujo RAW/YUV fmt %d de %dx%d: se pasa del "
+                        "modo %d al %d y se etiquetara remosaico",
+                        __FUNCTION__, f, mFullSizeQuadCfaWidth, mFullSizeQuadCfaHeight,
+                        operatingMode, modoQuadCfa);
+                operatingMode = modoQuadCfa;
+                break;
+            }
+        }
+    }
