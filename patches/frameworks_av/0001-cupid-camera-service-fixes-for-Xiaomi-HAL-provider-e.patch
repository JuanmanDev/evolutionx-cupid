+void Camera3Device::tagFullSizeQuadCfaRequestLocked(sp<CaptureRequest> &request) {
+    if (mFullSizeQuadCfaWidth <= 0 || request == nullptr) {
+        return;
+    }
+    bool esFotoCompleta = false;
+    for (size_t i = 0; i < request->mOutputStreams.size(); i++) {
+        const sp<Camera3OutputStreamInterface> &stream = request->mOutputStreams[i];
+        if (stream != nullptr
+                && (int32_t) stream->getWidth() == mFullSizeQuadCfaWidth
+                && (int32_t) stream->getHeight() == mFullSizeQuadCfaHeight) {
+            esFotoCompleta = true;
+            break;
+        }
+    }
+    // El HAL solo pone xiaomi.remosaic.detected a 1 si se le pide el remosaico
+    // mientras previsualiza. Marcando unicamente las peticiones que apuntan al
+    // flujo grande, nunca llega a evaluarlo y siempre contesta 0, que es lo que
+    // lee la camara de Xiaomi para decidir que no lo pide.
+    //
+    // Con esto se marcan todas las peticiones de una sesion que tenga un flujo
+    // del tamano completo, tambien las de vista previa:
+    //
+    //     setprop persist.sys.camera.qcfa_remosaic_always 1
+    const bool siempre =
+            property_get_int32("persist.sys.camera.qcfa_remosaic_always", 0) != 0;
+    if ((!esFotoCompleta && !siempre) || request->mSettingsList.empty()) {
+        return;
+    }
+
+    CameraMetadata &ajustes = request->mSettingsList.begin()->metadata;
+    sp<VendorTagDescriptor> vTags;
+    sp<VendorTagDescriptorCache> vCache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (vCache.get() != nullptr) {
+        const camera_metadata_t *buffer = ajustes.getAndLock();
+        metadata_vendor_id_t vendorId = get_camera_metadata_vendor_id(buffer);
+        ajustes.unlock(buffer);
+        vCache->getVendorTagDescriptor(vendorId, &vTags);
+    }
+    uint32_t tag = 0;
+    bool encontrada = (vTags.get() != nullptr)
+            && CameraMetadata::getTagFromName("xiaomi.remosaic.enabled",
+                    vTags.get(), &tag) == OK;
+
+    if (!encontrada && vCache.get() != nullptr) {
+        // El identificador de fabricante que trae la peticion no siempre
+        // acierta en la cache, y el descriptor global viene vacio dentro de
+        // cameraserver. Se recorren todos los descriptores hasta dar con ella.
+        for (const auto &par : vCache->getVendorIdsAndTagDescriptors()) {
+            if (par.second.get() == nullptr) continue;
+            if (CameraMetadata::getTagFromName("xiaomi.remosaic.enabled",
+                    par.second.get(), &tag) == OK) {
+                encontrada = true;
+                break;
+            }
+        }
+    }
+
+    if (!encontrada) {
+        // Dentro de cameraserver los descriptores de la cache vienen vacios y
+        // la busqueda por nombre no llega a ninguna parte. El identificador si
+        // se conoce: sale en dumpsys media.camera como
+        //     0x810e0000 (enabled) en la seccion xiaomi.remosaic
+        // Se deja en una propiedad por si cambia con otra version del HAL.
+        tag = (uint32_t) property_get_int32("persist.sys.camera.qcfa_remosaic_tag",
+                0x810e0000);
+        if (tag == 0) {
+            ALOGW("%s: el HAL no tiene xiaomi.remosaic.enabled", __FUNCTION__);
+            return;
+        }
+        ALOGI("%s: xiaomi.remosaic.enabled no aparece por nombre; se usa 0x%x",
+                __FUNCTION__, tag);
+    }
+    ALOGI("%s: xiaomi.remosaic.enabled encontrada (0x%x), se activa para la foto de %dx%d",
+            __FUNCTION__, tag, mFullSizeQuadCfaWidth, mFullSizeQuadCfaHeight);
+    const uint8_t encendido = 1;
+    status_t res = ajustes.update(tag, &encendido, 1);
+    if (res != OK) {
+        ALOGW("%s: no se pudo poner xiaomi.remosaic.enabled: %d", __FUNCTION__, res);
+    }
+
+    // Mandos para el revelado, apagados por defecto (-1 = no tocar nada y dejar
+    // que decidan la aplicacion y el HAL).
+    //
+    // La foto de 50 MP sale con efecto acuarela: el detalle fino esta ahi (se
+    // lee texto pequeno), pero las superficies quedan planchadas. Es la
+    // reduccion de ruido del HAL, que en el modo de remosaico se aplica sin que
+    // la aplicacion diga nada. Estos dos permiten probar otra cosa sin
+    // recompilar:
+    //
+    //     setprop persist.sys.camera.qcfa_nr 0     ruido: 0 apagado, 1 rapido,
+    //                                              2 alta calidad, 3 minimo
+    //     setprop persist.sys.camera.qcfa_edge 2   bordes: 0 apagado, 1 rapido,
+    //                                              2 alta calidad
+    //
+    // Contra el suavizado, lo que suele funcionar es bajar el primero (0 o 3).
+    // Aviso: puede que el HAL los ignore; se veria porque la foto no cambia.
+    const int32_t modoRuido = property_get_int32("persist.sys.camera.qcfa_nr", -1);
+    if (modoRuido >= 0) {
+        const uint8_t valor = (uint8_t) modoRuido;
+        if (ajustes.update(ANDROID_NOISE_REDUCTION_MODE, &valor, 1) != OK) {
+            ALOGW("%s: no se pudo poner el modo de reduccion de ruido", __FUNCTION__);
+        }
+    }
+
+    const int32_t modoBordes = property_get_int32("persist.sys.camera.qcfa_edge", -1);
+    if (modoBordes >= 0) {
+        const uint8_t valor = (uint8_t) modoBordes;
+        if (ajustes.update(ANDROID_EDGE_MODE, &valor, 1) != OK) {
+            ALOGW("%s: no se pudo poner el modo de bordes", __FUNCTION__);
+        }
+    }
+}
+
 status_t Camera3Device::capture(CameraMetadata &request, int64_t* lastFrameNumber) {
     ATRACE_CALL();
 
@@ -2609,6 +2724,108 @@ status_t Camera3Device::configureStreamsLocked(int operatingMode,
