+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::addQuadCfaFullSizeJpeg() {
+    bajarDuracionRawCompleto(mCameraCharacteristics, mId);
+
+    // Apagado por defecto: encenderlo aqui se lo ensena a todas las
+    // aplicaciones, incluidas las que no lo soportan. El camino normal es el
+    // de por aplicacion, en CameraService. Esto queda como interruptor para
+    // ensenarselo a todo el mundo:
+    //     setprop persist.sys.camera.qcfa_jpeg 1
+    if (property_get_int32("persist.sys.camera.qcfa_jpeg", 0) == 0) {
+        return OK;
+    }
+    return CameraProviderManager::aplicarJpegCompletoQuadCfa(mCameraCharacteristics, mId);
+}
