diff --git a/services/camera/libcameraservice/CameraService.cpp b/services/camera/libcameraservice/CameraService.cpp
index eda51932eb..5b59763a1f 100644
--- a/services/camera/libcameraservice/CameraService.cpp
+++ b/services/camera/libcameraservice/CameraService.cpp
@@ -1390,6 +1390,38 @@ std::string CameraService::cameraIdIntToStr(int cameraIdInt, int32_t deviceId,
     return cameraIdIntToStrLocked(cameraIdInt, deviceId, devicePolicy);
 }
 
+// Los paquetes a los que se les ensena el tamano completo del sensor.
+//
+// Se lee la misma propiedad que usa el HAL para decidir a quien le entrega
+// resolucion completa, para que las dos capas no puedan discrepar. Vacia o sin
+// definir, no se le ensena a nadie y todo queda como de fabrica.
+static bool paqueteQuiereResolucionCompleta(const std::string& paquete) {
+    if (paquete.empty()) {
+        return false;
+    }
+
+    char lista[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.vendor.camera.privapp.list", lista, "");
+    if (lista[0] == 0) {
+        return false;
+    }
+
+    // La propiedad es una lista separada por comas.
+    const std::string texto(lista);
+    size_t desde = 0;
+    while (desde <= texto.size()) {
+        size_t coma = texto.find(",", desde);
+        if (coma == std::string::npos) {
+            coma = texto.size();
+        }
+        if (texto.compare(desde, coma - desde, paquete) == 0) {
+            return true;
+        }
+        desde = coma + 1;
+    }
+    return false;
+}
+
 Status CameraService::getCameraCharacteristics(const std::string& unresolvedCameraId,
         int targetSdkVersion, const CameraCompatibilityInfo& compatInfo,
         const AttributionSourceState& clientAttribution, int32_t devicePolicy,
@@ -1447,6 +1479,24 @@ Status CameraService::getCameraCharacteristics(const std::string& unresolvedCame
         }
     }
 
+    // El sensor de este movil da 8192x6144, pero el HAL no anuncia ningun tamano
+    // de foto por encima de 4208x3120. Sin un tamano grande a la vista, la
+    // camara de Xiaomi no encuentra ninguno y acaba guardando a 1440x1080.
+    //
+    // No se puede anunciar a todo el mundo: los ports de Google Camera lo
+    // eligen y el HAL les rechaza la configuracion de flujos entera, con lo que
+    // se quedan con la vista previa en negro:
+    //     configure_streams() max_buffers : 0
+    //     Camera3-Device: Unable to configure stream 0 queue
+    //
+    // Se le ensena solo a los paquetes de persist.vendor.camera.privapp.list,
+    // que es la misma lista con la que el HAL decide a quien le entrega
+    // resolucion completa. Quien no este en ella ve las caracteristicas de
+    // siempre.
+    if (paqueteQuiereResolucionCompleta(clientAttribution.packageName.value_or(""))) {
+        CameraProviderManager::aplicarJpegCompletoQuadCfa(*cameraInfo, cameraId);
+    }
+
     return filterSensitiveMetadataIfNeeded(cameraId, cameraInfo);
 }
 
diff --git a/services/camera/libcameraservice/common/CameraProviderManager.cpp b/services/camera/libcameraservice/common/CameraProviderManager.cpp
index 9fb20a9672..efe67f69bb 100644
--- a/services/camera/libcameraservice/common/CameraProviderManager.cpp
+++ b/services/camera/libcameraservice/common/CameraProviderManager.cpp
@@ -22,6 +22,7 @@
 //#define LOG_NDEBUG 0
 
 #include "CameraProviderManager.h"
+#include <camera/VendorTagDescriptor.h>
 
 #include "config/SharedSessionConfigReader.h"
 
@@ -1926,6 +1927,491 @@ status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixupMonochromeTags()
     return res;
 }
 
+// Anade el tamano completo del sensor al mapa de configuraciones, como BLOB
+// y con sus duraciones.
+//
+// Va aparte de la caracteristica global a proposito: no todas las aplicaciones
+// lo quieren. Los ports de Google Camera se quedan en negro si lo ven, porque
+// el HAL les rechaza la configuracion de flujos entera:
+//     configure_streams() max_buffers : 0
+//     Camera3-Device: Can.t finish configuring output stream 0
+// Por eso CameraService solo se lo aplica a los paquetes que salen en
+// persist.vendor.camera.privapp.list, que es la misma lista con la que el HAL
+// decide a quien entrega resolucion completa.
+status_t CameraProviderManager::aplicarJpegCompletoQuadCfa(CameraMetadata& chars,
+        const std::string& idCamara) {
+    // El HAL de este movil (sensor Quad-Bayer) no anuncia ningun tamano de foto
+    // por encima de 4208x3120, aunque el sensor da 8192x6144 y el propio HAL
+    // acepta ese tamano si se le pide: comprobado con una sesion normal, sin
+    // modos propietarios. Sin el anuncio, las apps no pueden ofrecerlo (CameraX
+    // solo propone tamanos publicados) o se cierran al intentarlo.
+    //
+    // Aqui se anade ese tamano al mapa de configuraciones como BLOB, con sus
+    // duraciones.
+    //
+    // Viene apagado por defecto y no es un descuido: con el encendido, CameraX
+    // detecta el tamano y lo elige (baja la previa a 1600x1200 y limita a 3
+    // fps), pero al disparar se muere el HAL de camara
+    //     CAM-CRM: cam_req_mgr_close: ... userspace process has died
+    //     cameraserver: Camera provider 'legacy/1-3' has died
+    // porque reserva cuatro imagenes de 8192x6144 (unos 400 MB) y el HAL no lo
+    // aguanta. Una app que pida una sola imagen a resolucion completa si
+    // funciona, y por eso se deja la posibilidad de encenderlo:
+    //     setprop persist.sys.camera.qcfa_jpeg 1
+
+    // Las medidas del mosaico completo salen de la etiqueta de Qualcomm, que el
+    // HAL rellena aunque luego no publique ese tamano de foto. Es la fuente
+    // buena: la camara principal de este movil no se declara de ultra alta
+    // resolucion, asi que mirar la capacidad dejaba fuera justo la que
+    // interesa.
+    int32_t fullWidth = 0;
+    int32_t fullHeight = 0;
+
+    sp<VendorTagDescriptor> vTags;
+    sp<VendorTagDescriptorCache> vCache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (vCache.get() != nullptr) {
+        const camera_metadata_t *buffer = chars.getAndLock();
+        metadata_vendor_id_t vendorId = get_camera_metadata_vendor_id(buffer);
+        chars.unlock(buffer);
+        vCache->getVendorTagDescriptor(vendorId, &vTags);
+    }
+    uint32_t qcfaTag = 0;
+    if (CameraMetadata::getTagFromName(
+            "org.codeaurora.qcamera3.quadra_cfa.qcfa_dimension", vTags.get(), &qcfaTag) == OK) {
+        auto qcfa = chars.find(qcfaTag);
+        if (qcfa.count == 2) {
+            fullWidth = qcfa.data.i32[0];
+            fullHeight = qcfa.data.i32[1];
+            ALOGI("%s: el mosaico completo mide %dx%d segun el HAL",
+                    __FUNCTION__, fullWidth, fullHeight);
+        }
+    }
+
+    // Si no esta la etiqueta, vale igual lo que diga el sensor de si mismo. No
+    // se pide ademas que la camara se declare de ultra alta resolucion: la
+    // principal de este movil no lo hace y es justo la que interesa, porque es
+    // la unica que ven las aplicaciones.
+    if (fullWidth <= 0 || fullHeight <= 0) {
+        auto fullSize = chars.find(
+                ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE_MAXIMUM_RESOLUTION);
+        if (fullSize.count != 2) {
+            return OK;
+        }
+        fullWidth = fullSize.data.i32[0];
+        fullHeight = fullSize.data.i32[1];
+        ALOGI("%s: el sensor dice medir %dx%d a resolucion completa",
+                __FUNCTION__, fullWidth, fullHeight);
+    }
+    if (fullWidth <= 0 || fullHeight <= 0) {
+        return OK;
+    }
+
+    auto configs = chars.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    if (configs.count == 0) {
+        return OK;
+    }
+
+    // Si ya estuviera anunciado, no hay nada que hacer.
+    for (size_t i = 0; i + 3 < configs.count; i += 4) {
+        if (configs.data.i32[i] == HAL_PIXEL_FORMAT_BLOB &&
+                configs.data.i32[i + 1] == fullWidth &&
+                configs.data.i32[i + 2] == fullHeight) {
+            return OK;
+        }
+    }
+
+    // El JPEG a resolucion completa hace falta siempre: sin el, la camara de
+    // Xiaomi no encuentra ningun tamano grande en getOutputSizes() y se queda
+    // en 1440x1080, que es lo que acaba guardando.
+    //
+    // El RAW va aparte y apagado por defecto. Anunciarlo tiene un efecto
+    // secundario medido: los ports de Google Camera eligen RAW a resolucion
+    // completa para la lente principal y se quedan en negro, porque su tuberia
+    // necesita RAW o YUV a ese tamano y el YUV completo mata al HAL. Quien
+    // quiera el RAW grande, que lo encienda a proposito:
+    //
+    //     setprop persist.sys.camera.qcfa_raw 1
+    std::vector<int32_t> kFormatos;
+    kFormatos.push_back(HAL_PIXEL_FORMAT_BLOB);         // el JPEG de siempre
+    if (property_get_int32("persist.sys.camera.qcfa_raw", 0) != 0) {
+        kFormatos.push_back(HAL_PIXEL_FORMAT_RAW16);    // RAW_SENSOR, el de DngCreator
+        kFormatos.push_back(HAL_PIXEL_FORMAT_RAW10);    // el que piden los ports de GCam
+    }
+
+    std::vector<int32_t> newConfigs(configs.data.i32, configs.data.i32 + configs.count);
+    for (int32_t formato : kFormatos) {
+        bool yaEsta = false;
+        for (size_t i = 0; i + 3 < configs.count; i += 4) {
+            if (configs.data.i32[i] == formato &&
+                    configs.data.i32[i + 1] == fullWidth &&
+                    configs.data.i32[i + 2] == fullHeight &&
+                    configs.data.i32[i + 3] ==
+                            ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) {
+                yaEsta = true;
+                break;
+            }
+        }
+        if (yaEsta) {
+            continue;
+        }
+        newConfigs.push_back(formato);
+        newConfigs.push_back(fullWidth);
+        newConfigs.push_back(fullHeight);
+        newConfigs.push_back(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT);
+    }
+
+    // Las duraciones se copian de la foto mas grande que si estuviera anunciada,
+    // escaladas por la diferencia de area: es una estimacion prudente, y a las
+    // apps solo les sirve para decidir si pueden encadenar disparos.
+    auto minDurations = chars.find(
+            ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS);
+    auto stallDurations = chars.find(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS);
+
+    int64_t refMinDuration = 0;
+    int64_t refStallDuration = 0;
+    int64_t refArea = 0;
+    for (size_t i = 0; i + 3 < minDurations.count; i += 4) {
+        if (minDurations.data.i64[i] != HAL_PIXEL_FORMAT_BLOB) continue;
+        int64_t area = minDurations.data.i64[i + 1] * minDurations.data.i64[i + 2];
+        if (area > refArea) {
+            refArea = area;
+            refMinDuration = minDurations.data.i64[i + 3];
+        }
+    }
+    for (size_t i = 0; i + 3 < stallDurations.count; i += 4) {
+        if (stallDurations.data.i64[i] != HAL_PIXEL_FORMAT_BLOB) continue;
+        int64_t area = stallDurations.data.i64[i + 1] * stallDurations.data.i64[i + 2];
+        if (area == refArea) {
+            refStallDuration = stallDurations.data.i64[i + 3];
+        }
+    }
+    if (refMinDuration <= 0) refMinDuration = 33333333;      // 30 por segundo
+    if (refStallDuration <= 0) refStallDuration = refMinDuration;
+
+    const int64_t fullArea = static_cast<int64_t>(fullWidth) * fullHeight;
+    const int64_t factor = (refArea > 0) ? std::max<int64_t>(1, fullArea / refArea) : 4;
+
+    std::vector<int64_t> newMinDurations(minDurations.data.i64,
+                                         minDurations.data.i64 + minDurations.count);
+    for (int32_t formato : kFormatos) {
+        if (formato == HAL_PIXEL_FORMAT_BLOB) {
+            continue;
+        }
+        newMinDurations.push_back(formato);
+        newMinDurations.push_back(fullWidth);
+        newMinDurations.push_back(fullHeight);
+        newMinDurations.push_back(std::min<int64_t>(refMinDuration, 33333333));
+    }
+    newMinDurations.push_back(HAL_PIXEL_FORMAT_BLOB);
+    newMinDurations.push_back(fullWidth);
+    newMinDurations.push_back(fullHeight);
+    // Ojo con este valor: Android aparta a una lista distinta
+    // (getHighResolutionOutputSizes) los tamanos que no dan al menos unos 20
+    // fotogramas por segundo, y getOutputSizes deja de mostrarlos. Como la
+    // mayoria de las aplicaciones solo miran getOutputSizes, un tamano lento se
+    // vuelve invisible para ellas. Se declara la misma duracion que la foto mas
+    // grande que el HAL si publica, para que salga en la lista de siempre.
+    // Por debajo del umbral de los 20 fotogramas por segundo a proposito.
+    // StreamConfigurationMap aparta a getHighResolutionOutputSizes todo lo que
+    // declare mas de 50 ms por fotograma, y getOutputSizes deja de mostrarlo;
+    // como casi ninguna aplicacion consulta esa segunda lista, el tamano se
+    // vuelve invisible. Le pasa de fabrica a 4208x3120, que el HAL si publica y
+    // que tampoco aparece en el mapa. Aqui interesa que se vea, asi que se
+    // declara una duracion que lo deje en la lista de siempre.
+    newMinDurations.push_back(std::min<int64_t>(refMinDuration, 33333333));
+
+    std::vector<int64_t> newStallDurations(stallDurations.data.i64,
+                                           stallDurations.data.i64 + stallDurations.count);
+    for (int32_t formato : kFormatos) {
+        if (formato == HAL_PIXEL_FORMAT_BLOB) {
+            continue;
+        }
+        newStallDurations.push_back(formato);
+        newStallDurations.push_back(fullWidth);
+        newStallDurations.push_back(fullHeight);
+        newStallDurations.push_back(refStallDuration * factor);
+    }
+    newStallDurations.push_back(HAL_PIXEL_FORMAT_BLOB);
+    newStallDurations.push_back(fullWidth);
+    newStallDurations.push_back(fullHeight);
+    newStallDurations.push_back(refStallDuration * factor);
+
+    // Las entradas que ya existian para este tamano (el HAL publica RAW a
+    // resolucion completa aunque no lo parezca) llevan duraciones tan largas
+    // que Android las aparta de la lista que consultan las aplicaciones. Se les
+    // baja la duracion entre fotogramas para que salgan a la vista.
+    for (size_t i = 0; i + 3 < newMinDurations.size(); i += 4) {
+        if (newMinDurations[i + 1] == fullWidth && newMinDurations[i + 2] == fullHeight &&
+                newMinDurations[i + 3] > 33333333) {
+            ALOGI("%s: el formato %lld a %dx%d pasa de %lld a 33 ms por fotograma",
+                    __FUNCTION__, (long long) newMinDurations[i], fullWidth, fullHeight,
+                    (long long) newMinDurations[i + 3]);
+            newMinDurations[i + 3] = 33333333;
+        }
+    }
+
+    chars.update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS,
+                                  newConfigs.data(), newConfigs.size());
+    chars.update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,
+                                  newMinDurations.data(), newMinDurations.size());
+    chars.update(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS,
+                                  newStallDurations.data(), newStallDurations.size());
+
+    // El tamano maximo de JPEG tiene que dar de sobra para una foto de este
+    // tamano. El HAL comprueba que el bufer que le pasan pueda contener el
+    // peor caso (imagen muy detallada, sin apenas compresion) y si no llega,
+    // aborta al mapearlo. Un primer intento con ancho x alto x 3/4 (unos 37 MB)
+    // se quedaba corto y seguia fallando; se pone el caso peor de verdad, que
+    // es un byte y medio por pixel, mas sitio para las cabeceras.
+    {
+        auto maxJpeg = chars.find(ANDROID_JPEG_MAX_SIZE);
+        if (maxJpeg.count == 1) {
+            int64_t holgado = (int64_t) fullWidth * fullHeight * 3 / 2 + (8 << 20);
+            int32_t estimado = (int32_t) std::min<int64_t>(holgado, INT32_MAX);
+            if (estimado > maxJpeg.data.i32[0]) {
+                ALOGI("%s: el tamano maximo de JPEG pasa de %d a %d bytes",
+                        __FUNCTION__, maxJpeg.data.i32[0], estimado);
+                chars.update(ANDROID_JPEG_MAX_SIZE, &estimado, 1);
+            }
+        }
+    }
+
+    ALOGI("%s: camara %s: anunciado %dx%d como tamano de foto (el HAL no lo publicaba)",
+          __FUNCTION__, idCamara.c_str(), fullWidth, fullHeight);
+    return OK;
+}
+
+// Baja la duracion declarada del RAW a resolucion completa, para que salga en
+// getOutputSizes() y no en la lista de alta resolucion.
+//
+// El HAL ya publica esos tamanos; lo unico que hace esto es que dejen de estar
+// escondidos. Se aplica a todas las aplicaciones, a diferencia del anuncio del
+// JPEG completo, que va por aplicacion.
+static void bajarDuracionRawCompleto(CameraMetadata& chars, const std::string& idCamara) {
+    if (property_get_int32("persist.sys.camera.qcfa_raw_global", 0) == 0) {
+        return;
+    }
+
+    auto pixelArray = chars.find(ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE_MAXIMUM_RESOLUTION);
+    if (pixelArray.count < 2) {
+        return;
+    }
+    const int32_t anchoCompleto = pixelArray.data.i32[0];
+    const int32_t altoCompleto = pixelArray.data.i32[1];
+
+    const uint32_t etiquetas[] = {
+        ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,
+        ANDROID_SCALER_AVAILABLE_STALL_DURATIONS,
+    };
+
+    for (uint32_t etiqueta : etiquetas) {
+        auto entrada = chars.find(etiqueta);
+        if (entrada.count == 0) continue;
+
+        std::vector<int64_t> nuevas(entrada.data.i64, entrada.data.i64 + entrada.count);
+        bool tocado = false;
+        for (size_t i = 0; i + 3 < nuevas.size(); i += 4) {
+            const int32_t formato = (int32_t) nuevas[i];
+            const bool esRaw = (formato == HAL_PIXEL_FORMAT_RAW10
+                    || formato == HAL_PIXEL_FORMAT_RAW12
+                    || formato == HAL_PIXEL_FORMAT_RAW16
+                    || formato == HAL_PIXEL_FORMAT_RAW_OPAQUE);
+            if (!esRaw) continue;
+            if ((int32_t) nuevas[i + 1] != anchoCompleto) continue;
+            if ((int32_t) nuevas[i + 2] != altoCompleto) continue;
+            if (nuevas[i + 3] <= 33333333) continue;
+            ALOGI("bajarDuracionRawCompleto: camara %s: formato %d a %dx%d pasa de %lld a 33 ms",
+                    idCamara.c_str(), formato, anchoCompleto, altoCompleto,
+                    (long long) nuevas[i + 3]);
+            nuevas[i + 3] = 33333333;
+            tocado = true;
+        }
+        if (tocado) {
+            chars.update(etiqueta, nuevas.data(), nuevas.size());
+        }
+    }
+}
