+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::addQuadCfaActiveArrayFull() {
+    // libgcam exige que el RAW maximo coincida con el area activa o el pixel
+    // array. En Quad-Bayer el RAW maximo dobla al area activa binned, asi que
+    // GCam se cierra o captura a resolucion reducida. Aqui se declara la
+    // geometria del sensor a resolucion completa para que la app pida los 50 MP.
+    // Cambia el recorte/zoom que ven todas las apps: apagado por defecto.
+    //     setprop persist.sys.camera.qcfa_active_full 1
+    if (property_get_int32("persist.sys.camera.qcfa_active_full", 0) == 0) {
+        return OK;
+    }
+    auto& c = mCameraCharacteristics;
+    auto pixelMax = c.find(ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE_MAXIMUM_RESOLUTION);
+    auto activeMax = c.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE_MAXIMUM_RESOLUTION);
+    if (pixelMax.count != 2 || activeMax.count != 4) {
+        return OK;  // solo la camara que declara tamano de maxima resolucion
+    }
+    // Los punteros de find() apuntan al buffer de metadata y update() puede
+    // realocarlo, dejandolos colgando. Se copian los valores antes de tocar nada.
+    const int32_t pix[2] = { pixelMax.data.i32[0], pixelMax.data.i32[1] };
+    const int32_t act[4] = { activeMax.data.i32[0], activeMax.data.i32[1],
+                             activeMax.data.i32[2], activeMax.data.i32[3] };
+    status_t res = c.update(ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE, pix, 2);
+    if (res == OK) {
+        res = c.update(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE, act, 4);
+    }
+    if (res == OK) {
+        res = c.update(ANDROID_SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE, act, 4);
+    }
+    if (res == OK) {
+        ALOGI("%s: area activa a resolucion completa %dx%d en la camara %s",
+                __FUNCTION__, act[2], act[3], mId.c_str());
+    } else {
+        ALOGE("%s: no se pudo declarar el area activa completa: %s (%d)",
+                __FUNCTION__, strerror(-res), res);
+    }
+    return res;
+}
+
+// GCam (libgcam, static_metadata.cc) rechaza una camara si su RAW maximo
+// (frame_raw_max) no coincide con el area activa ni con el pixel array. En este
+// movil la camara fisica auxiliar "1" es Quad-Bayer y, tras el resync, anuncia
+// su geometria de maxima resolucion (p.ej. 6528x4896) mientras su area activa
+// base sigue binned (3264x2448). GCam enumera TODAS las camaras al arrancar,
+// falla en la "1" ("Create: StaticMetadata for sensor ID 1 failed basic error
+// checks" -> HalideRuntime.checkGcamHalideRuntime Failed) y se cierra con
+// Gcam.f() NPE, aunque capture con la principal "0".
+//
+// Aqui se iguala el area activa/pixel array de las camaras AUXILIARES (id != 0)
+// a su tamano de maxima resolucion, para que pasen la comprobacion de GCam. NO
+// se toca la principal "0": crecerla haria que GCam pidiera RAW a resolucion
+// completa y el preview saldria negro (limite del HAL, ver addQuadCfaActiveArrayFull).
+// Como las auxiliares no son la lente de captura de GCam, crecer su geometria
+// anunciada es inocuo. Reversible:
+//     setprop persist.sys.camera.gcam_aux_fix 0
+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::fixGcamAuxRawMismatch() {
+    // GCam (libgcam) calcula frame_raw_max con la salida RAW mas grande del mapa
+    // BASE de configuraciones (ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS) y
+    // exige frame_raw_max == area activa / pixel array. La camara principal (id 0)
+    // esconde su RAW full-res en el mapa de MAXIMA RESOLUCION (GCam lo ignora) y
+    // pasa; las auxiliares Quad-Bayer (p.ej. la frontal de 32MP) cuelan su RAW
+    // full-res (6528x4896) en el mapa BASE mientras su area activa es binned
+    // (3264x2448) -> GCam las rechaza ("StaticMetadata for sensor ID N failed")
+    // y crashea al enumerar.
+    //
+    // El enfoque correcto NO es agrandar el area activa (eso hace que GCam pida
+    // RAW full-res y el preview salga negro, porque el HAL solo entrega binned),
+    // sino CAPAR las salidas RAW del mapa base al area activa: asi frame_raw_max
+    // == area activa (GCam acepta) Y GCam pide RAW binned, que el HAL SI entrega.
+    // Solo auxiliares (id != 0); la principal no se toca. Reversible:
+    //     setprop persist.sys.camera.gcam_aux_fix 0
+    if (mId == "0") {
+        return OK;  // nunca la principal
+    }
+    if (property_get_int32("persist.sys.camera.gcam_aux_fix", 1) == 0) {
+        return OK;
+    }
+    auto& c = mCameraCharacteristics;
+
+    auto active = c.find(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+    if (active.count != 4) {
+        return OK;
+    }
+    const int32_t actW = active.data.i32[2];
+    const int32_t actH = active.data.i32[3];
+    if (actW <= 0 || actH <= 0) {
+        return OK;
+    }
+
+    auto isRaw = [](int32_t f) {
+        return f == HAL_PIXEL_FORMAT_RAW10 || f == HAL_PIXEL_FORMAT_RAW12
+            || f == HAL_PIXEL_FORMAT_RAW16 || f == HAL_PIXEL_FORMAT_RAW_OPAQUE;
+    };
+
+    auto configs = c.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    if (configs.count < 4) {
+        return OK;
+    }
+
+    std::vector<int32_t> keep;
+    keep.reserve(configs.count);
+    int rawDropped = 0;
+    int rawKeptAtActive = 0;
+    for (size_t i = 0; i + 3 < configs.count; i += 4) {
+        const int32_t fmt = configs.data.i32[i];
+        const int32_t w   = configs.data.i32[i + 1];
+        const int32_t h   = configs.data.i32[i + 2];
+        const int32_t dir = configs.data.i32[i + 3];
+        if (isRaw(fmt) && dir == ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT
+                && (w > actW || h > actH)) {
+            rawDropped++;
+            continue;  // se descarta la salida RAW full-res
+        }
+        if (isRaw(fmt) && w == actW && h == actH
+                && dir == ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) {
+            rawKeptAtActive++;
+        }
+        keep.push_back(fmt); keep.push_back(w); keep.push_back(h); keep.push_back(dir);
+    }
+
+    if (rawDropped == 0) {
+        return OK;  // no habia RAW full-res que capar
+    }
+
+    // Si al capar no queda ningun RAW al tamano activo, se añade uno (RAW10) para
+    // que GCam tenga un stream RAW valido al frame size.
+    if (rawKeptAtActive == 0) {
+        keep.push_back(HAL_PIXEL_FORMAT_RAW10);
+        keep.push_back(actW); keep.push_back(actH);
+        keep.push_back(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT);
+    }
+
+    status_t res = c.update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS,
+                            keep.data(), keep.size());
+    if (res != OK) {
+        ALOGE("%s: camara %s: no se pudo capar el RAW: %s (%d)",
+                __FUNCTION__, mId.c_str(), strerror(-res), res);
+        return res;
+    }
+
+    // Limpiar las duraciones RAW full-res correspondientes.
+    const uint32_t durTags[] = {
+        ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS,
+        ANDROID_SCALER_AVAILABLE_STALL_DURATIONS,
+    };
+    for (uint32_t tag : durTags) {
+        auto d = c.find(tag);
+        if (d.count < 4) continue;
+        std::vector<int64_t> keepD;
+        keepD.reserve(d.count);
+        bool tocado = false;
+        for (size_t i = 0; i + 3 < d.count; i += 4) {
+            const int64_t fmt = d.data.i64[i];
+            const int64_t w   = d.data.i64[i + 1];
+            const int64_t h   = d.data.i64[i + 2];
+            if (isRaw((int32_t) fmt) && (w > actW || h > actH)) { tocado = true; continue; }
+            keepD.push_back(d.data.i64[i]);     keepD.push_back(d.data.i64[i + 1]);
+            keepD.push_back(d.data.i64[i + 2]); keepD.push_back(d.data.i64[i + 3]);
+        }
+        if (tocado) c.update(tag, keepD.data(), keepD.size());
+    }
+
+    ALOGI("%s: camara auxiliar %s: capadas %d salidas RAW full-res al area activa %dx%d para GCam",
+            __FUNCTION__, mId.c_str(), rawDropped, actW, actH);
+    return OK;
+}
