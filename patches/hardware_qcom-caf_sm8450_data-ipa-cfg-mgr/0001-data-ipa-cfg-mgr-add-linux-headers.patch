+
+	/* Optional */
+	/*  Downlink Buffer Size */
+	__u8 dl_buf_size_valid;
+	/* Must be set to true if dl_buf_size is being passed */
+	__u32 dl_buf_size;
+	/* Informs the remote driver about the single xDCI buffer size.
