index 00000000..cfec6fb5
--- /dev/null
+++ b/ipacm/inc/linux/rmnet_ipa_fd_ioctl.h
@@ -0,0 +1,313 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note */
